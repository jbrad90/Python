#A get_item() function that takes in one parameter, the number of the item you want to order,
# and returns the name of that item!

def get_item(number):
  if number == 1:
    return 'Cheeseburger'
  elif number == 2:
    return 'Fries'
  elif number == 3:
    return 'Soda'
  elif number == 4:
    return 'Ice Cream'
  elif number == 5:
    return 'Cookie' 
  else:
    return 'Invalid Input'

